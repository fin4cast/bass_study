{
  "name": "bass-study",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:training": "node tests/training-browser.mjs",
    "test:audio": "node tests/audio-browser.mjs",
    "build": "npm run check && vite build",
    "start": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "tone": "15.1.22"
  }
}
