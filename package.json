{
  "name": "bass-study",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:training": "node tests/training-browser.mjs",
    "test:audio": "node tests/audio-browser.mjs",
    "test:storage": "node tests/storage-browser.mjs",
    "test:release": "node tests/release-browser.mjs",
    "test:ear": "node tests/ear-browser.mjs",
    "test:harmony": "node tests/harmony-browser.mjs",
    "test:tracks": "node tests/tracks-browser.mjs",
    "test:notation": "node tests/notation-browser.mjs",
    "test:input": "node tests/input-browser.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "build": "npm run check && vite build",
    "start": "node scripts/serve.mjs",
    "test:uiux": "node tests/uiux-browser.mjs",
    "test:design": "node tests/design-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "tone": "15.1.22",
    "vexflow": "5.0.0"
  }
}
